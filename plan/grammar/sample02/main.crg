use std::{fmt, NumWrite};
use std::vector::{Vec, vec, VecWrite};

fun main() ! fmt::IO? + NumWrite? + VecWrite? {
    let input = fmt::readln!().parse<u32>().unwrap_or(0u32)
    in let v = vec()
    in for i in 1..=input {
        v.push!(^i)
    };
    let result = 0u32
    in for item in v.iter() {
        result += ^item
    };
    fmt::println!("{}", result)    // result = input * (input + 1) / 2
}
