use std::fmt;

pub struct Object {
    value: i32,
}

impl Object {
    pub inline fun from(&drop value: i32) init {
        value,
    }

    pub fun add(&self: *, &i: i32) -> Self {
        Self::from(self.value + i)
    }
}

impl fmt::DisplayString for Object {
    pub inline fun to_string(&self) -> String {
        "{".to_string() + self.value.to_string() + "}".to_string()
    }
}
