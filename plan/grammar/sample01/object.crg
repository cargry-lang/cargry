use std::fmt;

pub struct Object {
    &drop value: i32,
}

impl Object {
    pub fun from(&drop value: i32) init {
        value,
    }

    pub fun add(&self: *, &i: i32) -> Self {
        Self::from(self.value + i)
    }
}

impl fmt::Display for Object {
    pub inline fun fmt(&self, &f: *fmt::Formatter) -> fmt::Formatter {
        fmt::write(f, "{{ {} }}", &self.value)
    }
}
