use std::fmt::{IO, println};

struct A<F>
where
    F: fun() -> () ! default,
{
    pub f: F,
}
impl<F> A<F>
where
    F: fun() -> () ! default,
{
    pub inline fun new(&drop f: F) init {
        f,
    }
}

struct B<F>
where
    F: fun() -> (),
{
    pub f: F,
}
impl<F> B<F>
where
    F: fun() -> (),
{
    pub inline fun new(&drop f: F) init {
        f,
    }
}

fun main() {
    let a = A::new(drop || -> () ! IO? {
        println!("hello.")
    });
    let b = B::new(drop || -> () (* error: ! IO? *) {
        (* error: println!("good bye.") *)
    });
    (a.f)();
    (b.f)();
}
